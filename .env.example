# ============================================================
# Plastic Promise environment example
# Copy to .env and adjust for the local machine.
# ============================================================

# ---- Storage paths ----
PLASTIC_DB_PATH=data/db/plastic_memory.db
PLASTIC_LANCEDB_PATH=data/lancedb
# Optional immutable-generation mode. When set, runtime resolves only the
# complete, verified current generation below this private root and does not
# mutate the active artifact. Build and promote with the management CLIs.
# PLASTIC_LANCEDB_GENERATION_ROOT=data/lancedb-generations
# Optional generation-bound writable projection. Bootstrap a new, empty target
# path from the verified current generation with manage_generation_live_index.py.
# Never point this at the immutable generation itself or reuse it after a
# generation promotion; checked outbox replay is the only incremental writer.
# PLASTIC_LANCEDB_LIVE_ROOT=data/lancedb-live/generation-<utc>

# ---- Embeddings ----
# Default local path: Ollama mxbai-embed-large (1024 dimensions).
EMBEDDER_PROVIDER=ollama
EMBEDDER_MODEL=mxbai-embed-large
PP_EMBEDDING_DIM=1024
OLLAMA_HOST=http://127.0.0.1:11434

# Optional structure-aware chunking and local semantic enrichment.
# Enrichment requires structure-v1. Keep it off for latency-sensitive writes;
# use shadow for bounded background validation; activate on with an offline
# rebuild, then keep it enabled for matching writes and repairs.
PP_MEMORY_CHUNKING=off
EMBEDDER_CHUNK_CHARS=512
# mxbai-embed-large has a 512-token context. Keep the character fallback
# conservative; raise this only after validating the selected model.
EMBEDDER_STRUCTURE_HARD_CHARS=512
EMBEDDER_STRUCTURE_MAX_CHUNKS=64
PP_MEMORY_CHUNK_ENRICHMENT=off
PP_MEMORY_CHUNK_ENRICHMENT_MODEL=qwen3:8b
# Optional: pin the exact Ollama model digest; otherwise it is resolved from /api/tags.
# PP_MEMORY_CHUNK_ENRICHMENT_MODEL_DIGEST=sha256:...
# PP_MEMORY_CHUNK_ENRICHMENT_MODEL_REVISION=qwen3:8b
# PP_MEMORY_CHUNK_ENRICHMENT_TIMEOUT=45
# PP_MEMORY_CHUNK_ENRICHMENT_NUM_PREDICT=768
# PP_MEMORY_CHUNK_ENRICHMENT_MAX_OUTPUT_CHARS=8192
# PP_MEMORY_CHUNK_ENRICHMENT_QUEUE_SIZE=32
# PP_MEMORY_CHUNK_ENRICHMENT_WORKER_IDLE_TIMEOUT=30
# PP_MEMORY_CHUNK_ENRICHMENT_CACHE_PATH=data/db/semantic_chunk_enrichment.db

# Optional OpenAI-compatible hosted embeddings. This remains disabled while
# EMBEDDER_PROVIDER=ollama. Replace the active provider/model values above and
# use the provider's API base URL, not its documentation URL. The embedding
# dimension must match PP_EMBEDDING_DIM and the persisted index schema.
# EMBEDDER_PROVIDER=openai-compatible
# EMBEDDER_API_KEY=
# EMBEDDER_BASE_URL=https://api.provider.example/v1
# EMBEDDER_PATH=/embeddings
# EMBEDDER_MODEL=text-embedding-v4
# EMBEDDER_MODEL_REVISION=text-embedding-v4
# EMBEDDER_DIMENSION=1024
# Some fixed-dimension compatible APIs reject the optional dimensions field.
# Set this to 0 only after proving the provider's native output is exactly the
# configured schema dimension; the mode is included in the index identity.
# EMBEDDER_SEND_DIMENSIONS=1
# EMBEDDER_BATCH_SIZE=32
# EMBEDDER_MAX_INPUT_BYTES=65536
# EMBEDDER_MAX_TOTAL_INPUT_BYTES=1048576
# EMBEDDER_MAX_REQUEST_BYTES=2097152
# EMBEDDER_MAX_RESPONSE_BYTES=16777216
# EMBEDDER_TIMEOUT=15
# EMBEDDER_TOTAL_TIMEOUT=60
# EMBEDDER_MAX_RETRIES=3
# EMBEDDER_RETRY_BACKOFF=0.25
# EMBEDDER_RETRY_BACKOFF_MAX=4
# EMBEDDER_CIRCUIT_FAILURE_THRESHOLD=5
# EMBEDDER_CIRCUIT_RECOVERY_SECONDS=30
# EMBEDDER_COST_PER_MILLION_TOKENS=
# Currency is explicit; omitted preserves the legacy USD interpretation.
# EMBEDDER_COST_CURRENCY=USD
# Required for promotable quality evidence when hosted embeddings are enabled.
# Pin this to the provider pricing schedule used by the cost calculation.
# EMBEDDER_PRICING_REVISION=

# Legacy official OpenAI mode is pinned to https://api.openai.com/v1 and uses
# OPENAI_API_KEY rather than EMBEDDER_API_KEY. Its 1536-dimensional vectors
# require replacing the active schema dimension as well.
# EMBEDDER_PROVIDER=openai
# EMBEDDER_MODEL=text-embedding-3-small
# PP_EMBEDDING_DIM=1536
# EMBEDDER_DIMENSION=1536
# OPENAI_API_KEY=

# ---- Reranking ----
# Local-first by default. Hosted rerankers require explicit opt-in.
PP_RERANK_PROVIDERS=ollama,cosine
# PP_RERANK_DISABLED=1

# Optional generic cloud reranker. Configure every required identity and
# credential field before adding cloud to the provider chain. original is the
# no-network fallback that preserves incoming order and scores.
# PP_RERANK_PROVIDERS=cloud,original
# PP_RERANK_API_KEY=
# PP_RERANK_BASE_URL=https://api.provider.example/v1
# PP_RERANK_PATH=/rerank
# PP_RERANK_CLOUD_MODEL=BAAI/bge-reranker-v2-m3
# PP_RERANK_CLOUD_MODEL_REVISION=BAAI/bge-reranker-v2-m3
# When cloud and Ollama share one fallback chain, the local model is always a
# separate setting. PP_RERANK_MODEL remains a legacy single-provider fallback.
# PP_RERANK_OLLAMA_MODEL=qwen2.5:3b
# PP_RERANK_TIMEOUT_SEC=5
# PP_RERANK_TOTAL_TIMEOUT_SEC=10
# PP_RERANK_MAX_RETRIES=2
# PP_RERANK_MAX_CANDIDATES=30
# PP_RERANK_MAX_DOCUMENT_CHARS=4000
# PP_RERANK_MAX_QUERY_CHARS=4000
# PP_RERANK_COST_PER_MILLION_TOKENS=
# PP_RERANK_COST_CURRENCY=USD
# PP_RERANK_PRICING_REVISION=
# Cost telemetry uses one blended total-token rate and does not model distinct
# provider input/output prices.

# ---- Authenticated inference gateway ----
# Run this as a separate loopback-only process (default port 9030). Keep the
# gateway token and provider keys only in a mode-600 server EnvironmentFile.
# The durable job database is intentionally separate from plastic_memory.db.
PP_INFERENCE_GATEWAY=0
# PP_INFERENCE_GATEWAY_PROJECT_ID=project:plastic-promise
# PP_INFERENCE_GATEWAY_TOKEN=
# PP_INFERENCE_GATEWAY_DB_PATH=data/inference/inference_jobs.db
# Exact comma-separated hosts permitted to receive cloud inference traffic.
# PP_INFERENCE_PROVIDER_HOST_ALLOWLIST=api.provider.example,rerank.provider.example
# Required only when a client supplies every vector without hosted embedding.
# These bootstrap-only values must match the opaque identity and dimension
# returned by the server capability contract.
# PP_INFERENCE_CLIENT_VECTOR_IDENTITY=
# PP_INFERENCE_CLIENT_VECTOR_DIMENSION=1024
# PP_INFERENCE_GATEWAY_TTL_SEC=900
# PP_INFERENCE_GATEWAY_LEASE_SEC=120
# PP_INFERENCE_GATEWAY_MAX_CONCURRENCY=4
# PP_INFERENCE_GATEWAY_MAX_ACTIVE_JOBS=1000
# PP_INFERENCE_GATEWAY_RETENTION_SEC=86400
# Defaults to four times MAX_ACTIVE_JOBS when unset.
# PP_INFERENCE_GATEWAY_MAX_RETAINED_ROWS=4000
# PP_INFERENCE_GATEWAY_MAX_RETAINED_JSON_BYTES=536870912

# ---- Authenticated remote configuration control plane ----
# This is a separate loopback-only process on 127.0.0.1:9040. It is not an
# MCP route and must not be exposed publicly. PP_CONTROL_ROOT contains immutable
# revision metadata, lifecycle-bounded private material, audit metadata, and the
# activated managed.env file. Provably stale private material is retired.
PP_CONTROL_PLANE=0
# PP_CONTROL_ROOT=data/control
# Exact loopback browser origins allowed to call the headless 9040 API. The
# default covers the Mac SSH-forwarded Dashboard and a server-local Dashboard.
# PP_CONTROL_ALLOWED_ORIGINS=http://127.0.0.1:19020,http://127.0.0.1:9020

# Store only SHA-256 digests in the server EnvironmentFile. Generate three
# distinct tokens with scripts/manage_control_credentials.py; it prints the
# plaintext values once for entry into Dashboard V2's operator session. Never
# commit either the tokens or these digests. The Dashboard keeps the supplied
# token in JS memory only and deliberately uses no cookies or browser storage.
# PP_CONTROL_VIEWER_TOKEN_SHA256=
# PP_CONTROL_OPERATOR_TOKEN_SHA256=
# PP_CONTROL_SECRET_ADMIN_TOKEN_SHA256=

# Bootstrap-only settings are intentionally outside remote configuration:
# database paths, listener binds, control authentication, service-manager and
# maintenance policy, gateway project ID/token, and provider host allowlist.
# Runtime units may load the activated file below as an additional systemd
# EnvironmentFile; activation returns restart_required and never runs systemctl.
# /path/from/PP_CONTROL_ROOT/managed.env

# Legacy fixed-endpoint hosted rerankers are also explicit opt-ins.
# PP_RERANK_PROVIDERS=jina,siliconflow,ollama,cosine
# JINA_API_KEY=
# SILICONFLOW_API_KEY=

# ---- DeepSeek JSON inference / cloud semantic enrichment ----
# These settings do not enable cloud work on their own. Cloud enrichment also
# requires PP_MEMORY_CHUNKING=structure-v1 and an explicit enrichment mode of
# shadow or on. The default above remains off and local Ollama remains selected.
#
# DEEPSEEK_API_KEY is accepted only for the canonical DeepSeek API base below.
# A custom compatible endpoint requires PP_INFERENCE_API_KEY (or the component
# override PP_MEMORY_CHUNK_ENRICHMENT_API_KEY); it never inherits a DeepSeek key.
# DEEPSEEK_API_KEY=
# PP_INFERENCE_PROVIDER=openai-compatible
# PP_INFERENCE_API_KEY=
# PP_INFERENCE_BASE_URL=https://api.deepseek.com
# PP_INFERENCE_PATH=/chat/completions
# PP_INFERENCE_MODEL=deepseek-v4-flash
# PP_INFERENCE_MODEL_REVISION=deepseek-v4-flash
# PP_INFERENCE_TEMPERATURE=0
# PP_INFERENCE_TOP_P=1
# PP_INFERENCE_JSON_MODE=1
# PP_INFERENCE_MAX_SYSTEM_PROMPT_BYTES=32768
# PP_INFERENCE_MAX_USER_PAYLOAD_BYTES=262144
# PP_INFERENCE_MAX_TOKENS=2048
# PP_INFERENCE_MAX_OUTPUT_CHARS=16384
# PP_INFERENCE_TIMEOUT_SEC=45
# PP_INFERENCE_TOTAL_TIMEOUT_SEC=120
# PP_INFERENCE_MAX_RETRIES=2
# PP_INFERENCE_RETRY_BACKOFF_SEC=0.5
# PP_INFERENCE_RETRY_BACKOFF_MAX_SEC=8
# PP_INFERENCE_CIRCUIT_FAILURE_THRESHOLD=5
# PP_INFERENCE_CIRCUIT_RECOVERY_SEC=30
# PP_INFERENCE_MAX_RESPONSE_BYTES=2097152
# PP_INFERENCE_COST_PER_MILLION_TOKENS=
# PP_INFERENCE_COST_CURRENCY=USD
# PP_INFERENCE_PRICING_REVISION=
# This is one blended total-token rate. Providers with distinct input/output
# prices require a future split-rate contract for exact cost accounting.

# The same structured JSON contract can run against a server-local Ollama
# process. This mode is loopback-only, sends no API key, ignores system proxy
# settings, and rejects redirects. Provider selection stays on the backend.
# PP_INFERENCE_PROVIDER=ollama
# PP_LOCAL_INFERENCE_BASE_URL=http://127.0.0.1:11434
# PP_LOCAL_INFERENCE_MODEL=qwen3:8b
# PP_LOCAL_INFERENCE_MODEL_REVISION=<pinned model digest or deployment revision>
# PP_LOCAL_INFERENCE_TIMEOUT_SEC=45
# PP_LOCAL_INFERENCE_TOTAL_TIMEOUT_SEC=120
# PP_LOCAL_INFERENCE_MAX_RETRIES=1

# To use DeepSeek for semantic chunk enrichment, replace the local model above
# and uncomment these values together. Component base URL, path, and API key are
# optional overrides; otherwise the PP_INFERENCE_* settings and canonical
# DEEPSEEK_API_KEY routing above apply.
# PP_MEMORY_CHUNKING=structure-v1
# PP_MEMORY_CHUNK_ENRICHMENT=shadow
# PP_MEMORY_CHUNK_ENRICHMENT_PROVIDER=openai-compatible
# PP_MEMORY_CHUNK_ENRICHMENT_MODEL=deepseek-v4-flash
# PP_MEMORY_CHUNK_ENRICHMENT_MODEL_REVISION=deepseek-v4-flash
# PP_MEMORY_CHUNK_ENRICHMENT_API_KEY=
# PP_MEMORY_CHUNK_ENRICHMENT_BASE_URL=https://api.deepseek.com
# PP_MEMORY_CHUNK_ENRICHMENT_PATH=/chat/completions
# PP_MEMORY_CHUNK_ENRICHMENT_TEMPERATURE=0
# PP_MEMORY_CHUNK_ENRICHMENT_TOP_P=1
# PP_MEMORY_CHUNK_ENRICHMENT_JSON_MODE=1
# Preserve a bounded number of strong BM25 keyword hits when reranking or MMR
# would otherwise remove exact names and identifiers.
PP_BM25_PRESERVATION=1
PP_BM25_PRESERVATION_THRESHOLD=0.72
PP_BM25_PRESERVATION_LIMIT=2

# ---- Passive context and governed passive memory ----
# All passive routes are fail-closed. Enable context preload and governed
# capture independently after reviewing their project and proposal policies.
PP_PASSIVE_CONTEXT=off
PP_PASSIVE_CONTEXT_MAX_CHARS=1000
PP_PASSIVE_TOOL_ROUTING=off
PP_PASSIVE_SEMANTIC_ROUTING=off
PP_PASSIVE_SEMANTIC_ROUTING_TIMEOUT_SECONDS=2
PP_PASSIVE_SEMANTIC_ROUTING_MIN_CONFIDENCE=0.75
PP_PASSIVE_MEMORY=off
PP_MEMORY_PROPOSALS=off
PP_PASSIVE_MEMORY_MAX_QUEUE=256
PP_PASSIVE_MEMORY_MAX_ATTEMPTS=5
PP_PASSIVE_MEMORY_RETRY_BASE_SECONDS=2
PP_PASSIVE_MEMORY_RETRY_MAX_SECONDS=300
PP_PASSIVE_MEMORY_PROCESSING_TIMEOUT_SECONDS=300
# Rule misses can reuse the structured-chunk JSON provider asynchronously.
# Jobs never mix project, visibility, config revision, or provider identity.
PP_PASSIVE_SEMANTIC_CAPTURE=off
PP_PASSIVE_SEMANTIC_BATCH_SIZE=20
PP_PASSIVE_SEMANTIC_MAX_WAIT_SECONDS=30
PP_PASSIVE_SEMANTIC_MAX_WORKERS=2
PP_PASSIVE_SEMANTIC_MAX_QUEUE=4096
PP_PASSIVE_SEMANTIC_MAX_ATTEMPTS=4
PP_PASSIVE_SEMANTIC_RETRY_SECONDS=10
PP_PASSIVE_SEMANTIC_LEASE_SECONDS=180
PP_PASSIVE_SEMANTIC_POLL_SECONDS=1
PP_PASSIVE_SEMANTIC_WORKER_AUTOSTART=1
PP_PASSIVE_SEMANTIC_MAINTENANCE_BATCHES=4
# Promotion remains governed and fail-closed. shadow records would-promote;
# on invokes the existing canonical atomic promoter after all policy gates pass.
PP_MEMORY_PROPOSAL_AUTO_ADOPT=off
PP_MEMORY_PROPOSAL_AUTO_THRESHOLD=0.82
PP_MEMORY_PROPOSAL_REQUIRE_VECTOR=1
PP_PROPOSAL_PROMOTION_BATCH_SIZE=20
PP_PROPOSAL_PROMOTION_MAX_WAIT_SECONDS=5
PP_PROPOSAL_PROMOTION_MAX_QUEUE=4096
PP_PROPOSAL_PROMOTION_MAX_ATTEMPTS=4
PP_PROPOSAL_PROMOTION_RETRY_SECONDS=10
PP_PROPOSAL_PROMOTION_LEASE_SECONDS=180
PP_PROPOSAL_PROMOTION_POLL_SECONDS=1
PP_PROPOSAL_PROMOTION_WORKER_AUTOSTART=1
PP_PROPOSAL_PROMOTION_RECONCILE_LIMIT=100
PP_PROPOSAL_PROMOTION_MAINTENANCE_BATCHES=4

# ---- Codex passive-memory hooks ----
# Project hooks call the same governed MCP adapter; failures always continue
# without blocking Codex. Turn state is ephemeral and removed after Stop.
PP_CODEX_HOOK_MCP_URL=http://127.0.0.1:9020/mcp
PP_CODEX_HOOK_TIMEOUT_SEC=4
PP_CODEX_HOOK_STATE_DIR=var/codex-hooks
PP_CODEX_HOOK_STATE_TTL_SEC=21600
PP_CODEX_HOOK_MAX_TEXT_CHARS=65536
PP_CODEX_HOOK_PROJECT_POLICY=balanced
PP_CODEX_HOOK_VERBOSE=0
# PP_CODEX_HOOK_PROJECT_ID=project:plastic-promise
# PP_CODEX_HOOK_BEARER_TOKEN=
# ---- Trust system ----
PP_TRUST_INITIAL=0.60
PP_TRUST_MIN=0.10
PP_TRUST_MAX=1.00

# ---- Audit ----
PP_AUDIT_PRE_CHECK_ENABLED=true
PP_AUDIT_LOG_PATH=data/audit.log

# ---- Runtime ----
PP_RUST_ENGINE=auto
PP_LOG_LEVEL=INFO

# ---- Local operations dashboard ----
# V2 is fail-closed and only accepts the exact value 1. Local mode requires
# a loopback HTTP bind and a server-owned project scope.
PP_DASHBOARD_V2=0
PP_RETRIEVAL_EXPLAIN=0
# Exact 1 enables the only Dashboard write surface: governed proposal review.
# The server still applies feedback_apply trust and project authorization.
PP_DASHBOARD_REVIEW_ACTIONS=0
PP_DASHBOARD_AUTH=local
# PP_DASHBOARD_PROJECT_ID=project:plastic-promise

# ---- Agent owner ----
# Used to isolate memories in multi-agent setups.
# AGENT_OWNER=main-dev
