flowchart TB
    Client["Codex Hook / MCP Client / Dashboard"] -->|"loopback HTTP or SSH LocalForward"| Gateway["MCP Gateway"]
    Gateway --> Scope["Request scope and governance"]
    Scope --> Context["Context Engine\nretrieve and fuse"]
    Scope --> Pipeline["Memory / proposal admission"]
    Context --> SQLite[("SQLite WAL\nonly canonical truth")]
    Context --> Lance[("LanceDB generation\nderived retrieval")]
    Pipeline -->|"canonical transaction + outbox"| SQLite
    SQLite -. "bounded project-scoped work" .-> Maintenance["Maintenance\nretry + reconcile"]
    Maintenance -->|"derived vector / JSON / rerank"| Inference{"Configured inference"}
    Inference --> Cloud["Hosted provider\nconfigured egress only"]
    Inference --> Node["Local heterogeneous node\nloopback / restricted tunnel"]
    Maintenance -->|"derived projection"| Lance
    Node -. "identity proof required" .-> Maintenance
    Cloud -. "identity proof required" .-> Maintenance
    Release["Release delivery\nPR -> RC -> protected stable"] -. "immutable software evidence only" .-> Gateway

    classDef truth fill:#134e4a,stroke:#34d399,color:#f8fafc;
    classDef derived fill:#312e81,stroke:#a78bfa,color:#f8fafc;
    classDef runtime fill:#155e75,stroke:#67e8f9,color:#f8fafc;
    class SQLite truth;
    class Lance,Cloud,Node derived;
    class Gateway,Scope,Context,Pipeline,Maintenance runtime;
