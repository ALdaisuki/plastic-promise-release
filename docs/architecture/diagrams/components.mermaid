flowchart LR
    Handler["Tool handler"] --> Scope["Request scope"]
    Scope --> Policy["Defense / policy / audit"]
    Policy --> Recall["Context retrieval planner"]
    Recall --> Fusion["Rank fusion and result guard"]
    Fusion --> Package["Context package"]

    Handler --> Admission["Canonical admission"]
    Admission --> SQLite[("SQLite WAL")]
    SQLite --> Outbox["Durable outbox"]
    Outbox -. "bounded async claim" .-> Worker["Maintenance worker"]
    Worker --> Identity["Model and transport identity gate"]
    Identity --> Adapter["Provider / node adapter"]
    Adapter --> Worker
    Worker --> Generation["LanceDB shadow / live generation"]

    SQLite --> Recall
    Generation --> Recall
