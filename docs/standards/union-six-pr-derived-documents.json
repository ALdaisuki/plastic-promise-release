    "tracked_drift_is_passing": false,
    "content_set_algorithm": "sha256-entry-id-locale-path-content-v1",
    "content_set_sha256": "6a8fc2c2b0425d271b10ee581413e4782d9863e77c7ca09a11497755c5d1a336",
    "rules": [
      "every listed path is part of the critical derived-document family and must be checked on each affected PR",
      "tracked-drift is a blocking evidence record, not a waiver, exception, or successful parity result",
      "a bilingual pair must preserve the same architecture, status, completion, badge, link, resource, and pricing claims even when wording differs",
      "document kinds are closed and dispatched: bilingual Markdown uses en/zh_CN paths while a language-neutral governance document uses exactly one path",
      "every required Markdown document declares semantic claims whose markers must be present in each governed locale",
      "an asset that carries architecture or status claims must bind the current union-contract revision",
      "SVG semantic claims are read only from visible text/tspan content; script, foreignObject, event-handler attributes, and external href targets fail closed",
      "the content-set digest binds every registered locale path and its present or missing raw-content state"
    ]
  },
