# Copy outside the repository, replace the image with a reviewed release
# manifest digest, and keep secrets in a separate operator-owned environment
# source. No canonical state is bundled into the image. The three PLASTIC_*
# paths must refer to the same state root for both Compose and native systemd.
# PP_SERVER_STATE_DIRECTORY is consumed by Compose as the host bind source.
PP_SERVER_STATE_DIRECTORY=/var/lib/plastic-promise
TZ=UTC
PLASTIC_RUNTIME_MODE=normal
PLASTIC_DB_PATH=/var/lib/plastic-promise/db/plastic_memory.db
PLASTIC_LANCEDB_PATH=/var/lib/plastic-promise/lancedb
PLASTIC_RUNTIME_LOCK_PATH=/var/lib/plastic-promise/runtime/mcp.lock
PLASTIC_PROMISE_SERVER_IMAGE=
