# Operator profile for scripts/setup_windows_compute_node.ps1.
# Copy to ${USERPROFILE}\.plastic-promise\node.env on the operator machine and
# edit values.  Never commit this file or any real credential / private
# endpoint value.  Paths below are generic examples; Python and the
# interactive user profile are auto-detected when a value is omitted.

# --- build inputs (must stay SHA-scoped) -----------------------------------
PP_WINDOWS_BUILD_SOURCE_REVISION=<40-char-source-sha>
# PP_WINDOWS_BUILD_REPOSITORY_ROOT=<sha-scoped-source-root> (auto-derived)
PP_PLASTIC_PROMISE_WORKSPACE=${USERPROFILE}\PlasticPromise
# PP_DOCKER_COMMAND=docker.exe (Docker Desktop) or
#   PP_DOCKER_COMMAND=wsl.exe -d Ubuntu-22.04 -e docker (WSL2 native daemon;
#   preflight auto-detects and writes this value)
# PP_WINDOWS_BUILD_EXECUTION_MODE=native-docker (desktop) / wsl (WSL native;
#   derived from PP_DOCKER_COMMAND when omitted)
PP_WINDOWS_BUILD_IMAGE_TAG=plastic-promise-local-inference-node:main-<short-sha>
PP_WINDOWS_BUILD_BUILDER=plastic-promise-local
PP_WINDOWS_BUILD_CACHE_RETENTION_HOURS=24
PP_WINDOWS_BUILD_REPORT_DIRECTORY=artifacts/local-node-build
# PP_WINDOWS_USER_PROFILE=<your-user-profile> (auto-detected when omitted)

# --- host preflight (scripts/preflight_windows_node_host.ps1) ---------------
# PP_WSL_DISTRO=Ubuntu-22.04
# PP_WSL_VHDX_TARGET=D:\WSL (migrates the WSL VHDX off the system disk)
# PP_PROXY_URL=http://127.0.0.1:7897 (verified from WSL; loopback is translated
#   to the WSL host gateway when NAT mode requires it, then persisted for the
#   WSL shell, Docker daemon, and BuildKit arguments; HTTP(S) only and must not
#   contain username/password URI userinfo)
# PP_WSL_MEMORY=16GB (auto-sized when omitted)
# PP_WSL_PROCESSORS=8 (auto-sized when omitted)
# PP_WSL_SWAP=4GB (auto-sized when omitted)
# PP_WSL_VM_IDLE_TIMEOUT=6000000

# --- local services --------------------------------------------------------
# Start the selected llama.cpp embedding and rerank servers before the node,
# or use the installation wizard to install and register them.
# PP_PYTHON_EXECUTABLE=<path-to-python.exe> (auto-detected when omitted)

# --- node identity (required; revisions are pinned operator config) ---------
PP_LOCAL_NODE_ID=inference-node
PP_LOCAL_NODE_AUTHORIZATION=Bearer <random-private-node-token>
PP_LOCAL_NODE_RESOURCE_GUARD=on
PP_LOCAL_NODE_RESOURCE_GPU_UTILIZATION_LIMIT=70
PP_LOCAL_NODE_RESOURCE_SAMPLE_TTL_SECONDS=2
PP_LOCAL_NODE_RESOURCE_RETRY_AFTER_SECONDS=5
PP_LOCAL_NODE_EMBEDDING_BACKEND=llama.cpp
PP_LOCAL_NODE_EMBEDDING_MODEL=Qwen3-Embedding-4B-GGUF
PP_LOCAL_NODE_EMBEDDING_REVISION=<fixed-40-hex-model-revision>
PP_LOCAL_NODE_EMBEDDING_DIMENSION=2560
PP_LOCAL_NODE_EMBEDDING_NORMALIZATION=l2
PP_LOCAL_NODE_EMBEDDING_ARTIFACT_SHA256=sha256:<64-hex-model-file-digest>
PP_LOCAL_NODE_EMBEDDING_MODEL_REFERENCE=/models/embedding/Qwen3-Embedding-4B-Q4_K_M.gguf
PP_LOCAL_NODE_EMBEDDING_LLAMA_CPP_BASE_URL=http://127.0.0.1:19131
PP_LOCAL_NODE_EMBEDDING_LLAMA_CPP_PATH=/v1/embeddings
PP_LOCAL_NODE_RERANK_BACKEND=llama.cpp
PP_LOCAL_NODE_RERANK_MODEL=Qwen3-Reranker-4B-GGUF
PP_LOCAL_NODE_RERANK_REVISION=<fixed-40-hex-rerank-revision>
PP_LOCAL_NODE_RERANK_ARTIFACT_SHA256=sha256:<64-hex-model-file-digest>
PP_LOCAL_NODE_RERANK_MODEL_REFERENCE=/models/rerank/Qwen3-Reranker-4B-Q4_K_M.gguf
PP_LOCAL_NODE_RERANK_LLAMA_CPP_BASE_URL=http://127.0.0.1:19132
PP_LOCAL_NODE_RERANK_LLAMA_CPP_PATH=/rerank
# PP_LOCAL_NODE_EMBEDDER_TIMEOUT=10
# PP_LOCAL_NODE_PYTORCH_ALLOC_CONF=expandable_segments:True (reduce CUDA fragmentation for the reranker)
PP_LOCAL_NODE_MODEL_DIRECTORY=<your-pre-populated-model-directory>
# PP_NODE_COMPOSE_FILE=deploy\local-inference-node\compose.cuda.yaml
# PP_NODE_BASE_URL=http://127.0.0.1:19130
# PP_NODE_CONTAINER_NAME=local-inference-node-pp-compute-node-1
# HF_ENDPOINT=https://hf-mirror.com
