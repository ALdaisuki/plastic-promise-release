[Unit]
Description=Plastic Promise remote configuration control plane
Documentation=https://github.com/ALdaisuki/plastic-promise/blob/main/docs/remote-control-plane.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=plastic
Group=plastic
WorkingDirectory=/srv/plastic-promise/runtime
UMask=0077
Environment=TZ=UTC
EnvironmentFile=/srv/plastic-promise/state/plastic-promise.env
EnvironmentFile=/srv/plastic-promise/state/secrets/control-credentials.env
EnvironmentFile=-/srv/plastic-promise/state/control/managed.env
ExecStart=/srv/plastic-promise/runtime/.venv/bin/plastic-promise-control-plane --port 9040
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=30s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plastic-promise-control-plane

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
# Hide SSH/GitHub credentials and reveal only uv's managed Python runtime,
# which is the target of the runtime venv's interpreter symlink.
ProtectHome=tmpfs
BindReadOnlyPaths=/home/plastic/.local/share/uv/python
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Immutable revisions, audit metadata, and managed.env live below this root.
ReadWritePaths=/srv/plastic-promise/state/control
ReadOnlyPaths=/srv/plastic-promise/state/secrets

[Install]
WantedBy=multi-user.target
